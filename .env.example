# Slack
SLACK_BOT_TOKEN=xoxb-           # Bot User OAuth Token (from Slack app OAuth & Permissions)
SLACK_SIGNING_SECRET=            # Signing Secret (from Slack app Basic Information)
SLACK_APP_TOKEN=xapp-            # App-Level Token with connections:write scope (for Socket Mode)
SLACK_USER_ID=U                  # Your Slack user ID — the only user the bot DMs and the only one it answers

# Anthropic
ANTHROPIC_API_KEY=sk-ant-        # Anthropic API key (console.anthropic.com)
ANTHROPIC_MODEL=                 # Optional model ID override. Blank → claude-sonnet-4-6

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://  # Upstash Redis REST URL (upstash.com console)
UPSTASH_REDIS_REST_TOKEN=        # Upstash Redis REST token
REDIS_URL=rediss://              # Upstash Redis ioredis connection string (for BullMQ)

# MCP (served on PORT at /mcp/sse)
MCP_AUTH_TOKEN=                  # Shared secret; clients send `Authorization: Bearer <token>`. Required when NODE_ENV=production

# App
PORT=3000
NODE_ENV=production
SINGLE_USER_ID=erick             # User ID used for all Redis keys (single-user build)
USER_TIMEZONE=America/Chicago    # Your local timezone (used for scheduler ping windows)

# Content
SEED_PATH=                       # Path to your concept library JSON (absolute or repo-relative). Blank → content/concepts-seed.example.json
