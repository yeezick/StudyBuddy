{
  "name": "studyagent",
  "version": "0.1.0",
  "description": "StudyAgent MLP — Slack bot + MCP server for AI-driven spaced retrieval study sessions",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "NODE_ENV=test node --test test/*.test.js",
    "db:migrate": "node scripts/db-migrate.js",
    "check": "find src scripts test -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/bolt": "^4.7.3",
    "@upstash/redis": "^1.34.0",
    "bullmq": "^5.76.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.10.1",
    "pg": "^8.23.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.4.2"
  }
}
